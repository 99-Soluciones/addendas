# ============================================================
#  Addenda SaaS - variables de entorno (plantilla)
#  Copia este archivo como .env y rellena los valores reales.
# ============================================================

# ---------- API ----------
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
# Origen permitido para CORS (frontend)
WEB_ORIGIN=http://localhost:5173
# Docs OpenAPI/Swagger en /api/v1/docs. Vacio = activo en dev/test, apagado en
# produccion. Forzar con true/false.
DOCS_ENABLED=

# ---------- Base de datos (Supabase Postgres) ----------
# Runtime: conexion pooled (pgBouncer, puerto 6543)
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migraciones: conexion directa (puerto 5432)
DIRECT_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------- Auth (JWT) ----------
JWT_ACCESS_SECRET=cambia-esto-access
JWT_REFRESH_SECRET=cambia-esto-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Supabase Storage (archivos XML de addendas) ----------
SUPABASE_URL=https://REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cambia-esto
SUPABASE_STORAGE_BUCKET=addendas

# ---------- Correo (SMTP / Nodemailer) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Addenda SaaS <no-reply@example.com>"

# ---------- WEB (Vite) ----------
VITE_API_URL=http://localhost:3000/api/v1
